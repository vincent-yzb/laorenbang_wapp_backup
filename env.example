# ========================================
# 老人帮后端服务 - 环境配置模板
# ========================================
# 复制此文件为 .env 并填写实际配置

# 基础配置
NODE_ENV=development
PORT=3001
CORS_ORIGIN=*

# 数据库配置 (PostgreSQL)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# JWT 配置
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# Redis 配置 (可选，用于缓存和验证码)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ========================================
# 微信小程序配置
# ========================================
WECHAT_APPID=your-wechat-appid
WECHAT_APP_SECRET=

# 微信支付配置
WECHAT_MCH_ID=your-wechat-mch-id
WECHAT_PAY_KEY=
WECHAT_PAY_CERT_PATH=/path/to/apiclient_cert.pem
WECHAT_PAY_KEY_PATH=

# ========================================
# 腾讯云配置
# ========================================

# 短信服务
SMS_SECRET_ID=
SMS_SECRET_KEY=
SMS_APP_ID=your-sms-app-id
SMS_SIGN_NAME=老人帮

# 对象存储 COS
COS_SECRET_ID=
COS_SECRET_KEY=
COS_BUCKET=your-bucket-name
COS_REGION=ap-beijing

# ========================================
# 高德地图配置
# ========================================
AMAP_KEY=
AMAP_SECRET=

# ========================================
# 其他配置
# ========================================

# 平台佣金比例 (0-1)
PLATFORM_COMMISSION=0.2

