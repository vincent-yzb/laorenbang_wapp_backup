# Use only with an isolated development database.
NODE_ENV=development
PORT=3001
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
DIRECT_URL=postgresql://USER:PASSWORD@DIRECT_HOST:5432/DATABASE
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# WeChat login and authorized phone binding; real values stay server-side.
WECHAT_APPID=
WECHAT_APP_SECRET=

# Both mock switches default to off. Neither switch can enable production mocks.
ALLOW_MOCK_PAYMENT=false
ALLOW_MOCK_SMS=false

# Optional server-side geocoding.
AMAP_KEY=

# This iteration does not provide a live merchant payment/refund/withdraw gateway.
